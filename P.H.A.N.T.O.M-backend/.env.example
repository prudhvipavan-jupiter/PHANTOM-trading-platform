PORT=5000
NODE_ENV=development
SERVE_FRONTEND=true
USE_MEMORY_DB=true

JWT_SECRET=change_this_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret

# Paytm Money Open API — https://developer.paytmmoney.com/
PAYTM_MONEY_API_KEY=your_api_key
PAYTM_MONEY_API_SECRET=your_api_secret
# Must match redirect URL registered on Paytm developer portal
PAYTM_REDIRECT_URL=http://localhost:5000/api/brokers/paytm/callback
FRONTEND_URL=http://localhost:5000

# Safety cap per live order (shares)
MAX_LIVE_ORDER_QTY=500
