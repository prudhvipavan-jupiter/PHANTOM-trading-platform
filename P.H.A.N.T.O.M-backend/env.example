# P.H.A.N.T.O.M Trading Platform Environment Configuration
# World's Best Profit-Generating Trading Platform

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/phantom_trading
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=phantom_trading_secret_key_2024_profit_generator
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=phantom_refresh_secret_2024
JWT_REFRESH_EXPIRE=7d

# API Keys for Market Data
YAHOO_FINANCE_API_KEY=your_yahoo_finance_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
POLYGON_API_KEY=your_polygon_api_key
QUANDL_API_KEY=your_quandl_api_key

# Indian Market APIs
NSE_INDIA_API_KEY=your_nse_india_api_key
MONEYCONTROL_API_KEY=your_moneycontrol_api_key
SCREENER_API_KEY=your_screener_api_key

# Broker API Keys (for real trading)
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret
PAYTM_MONEY_API_KEY=your_paytm_money_api_key
PAYTM_MONEY_API_SECRET=your_paytm_money_api_secret
ANGEL_ONE_API_KEY=your_angel_one_api_key
ANGEL_ONE_API_SECRET=your_angel_one_api_secret
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret

# AI/ML Services
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
COHERE_API_KEY=your_cohere_api_key

# News and Sentiment APIs
NEWS_API_KEY=your_news_api_key
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Email Service (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# SMS Service (for alerts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Payment Gateway (for premium features)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloud Services
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=phantom-trading-data

# Monitoring and Analytics
SENTRY_DSN=your_sentry_dsn
GOOGLE_ANALYTICS_ID=your_google_analytics_id
MIXPANEL_TOKEN=your_mixpanel_token

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
TRADING_RATE_LIMIT_MAX_REQUESTS=10
AI_RATE_LIMIT_MAX_REQUESTS=20

# Trading Configuration
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
PRE_MARKET_OPEN=09:00
POST_MARKET_CLOSE=15:45

# AI Model Configuration
AI_MODEL_UPDATE_INTERVAL=3600000
AI_PREDICTION_EXPIRY_HOURS=24
AI_CONFIDENCE_THRESHOLD=70
AI_MAX_PREDICTIONS_PER_SYMBOL=5

# Cache Configuration
CACHE_TTL=300000
MARKET_DATA_CACHE_TTL=30000
AI_PREDICTION_CACHE_TTL=3600000
USER_DATA_CACHE_TTL=1800000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs
MAX_LOG_FILE_SIZE=10485760
MAX_LOG_FILES=5

# Performance Configuration
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30000
WEBSOCKET_HEARTBEAT_INTERVAL=30000
DATABASE_CONNECTION_POOL_SIZE=10

# Feature Flags
ENABLE_REAL_TRADING=false
ENABLE_AI_PREDICTIONS=true
ENABLE_SOCIAL_TRADING=true
ENABLE_COPY_TRADING=true
ENABLE_OPTIONS_TRADING=true
ENABLE_FUTURES_TRADING=true
ENABLE_FOREX_TRADING=true
ENABLE_CRYPTO_TRADING=true
ENABLE_PAPER_TRADING=true
ENABLE_NOTIFICATIONS=true
ENABLE_EMAIL_ALERTS=true
ENABLE_SMS_ALERTS=true
ENABLE_PUSH_NOTIFICATIONS=true

# Development Configuration
ENABLE_MOCK_DATA=true
ENABLE_DEBUG_MODE=true
ENABLE_HOT_RELOAD=true
ENABLE_API_DOCUMENTATION=true 